{
  "name": "super-http",
  "version": "1.0.0",
  "description": "A resilient HTTP client built on top of Axios with circuit breaker, connection pooling, keep-alive and smart retry",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"src/**/*.(js|ts)\"",
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --fix --ext .js,.ts",
    "test": "jest --config jest.config.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebertcisco/super-http.git"
  },
  "keywords": [
    "http",
    "axios",
    "circuit-breaker",
    "retry",
    "keep-alive",
    "connection-pool",
    "resilience",
    "typescript"
  ],
  "author": "Hebert Cisco",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hebertcisco/super-http/issues"
  },
  "homepage": "https://github.com/hebertcisco/super-http#readme",
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "29.4.0",
    "@typescript-eslint/eslint-plugin": "5.54.0",
    "@typescript-eslint/parser": "5.52.0",
    "eslint": "8.35.0",
    "eslint-plugin-jest": "27.2.1",
    "express": "^4.18.2",
    "jest": "29.4.3",
    "prettier": "2.8.4",
    "ts-jest": "29.0.5",
    "typescript": "4.9.5"
  },
  "files": [
    "lib/**/*"
  ],
  "dependencies": {
    "axios": "^1.3.4"
  }
}
