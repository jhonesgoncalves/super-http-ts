{
  "name": "super-http",
  "version": "1.0.0",
  "description": "A resilient HTTP client built on top of Axios — circuit breaker, connection pooling, keep-alive and smart retry",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "tsc",
    "docs": "typedoc",
    "format": "prettier --write \"src/**/*.(js|ts)\"",
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --fix --ext .js,.ts",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhonesgoncalves/super-http-ts.git"
  },
  "keywords": [
    "http",
    "axios",
    "circuit-breaker",
    "retry",
    "keep-alive",
    "connection-pool",
    "resilience",
    "typescript",
    "node",
    "http-client"
  ],
  "author": "Jhones Gonçalves <jhonesgoncalves@github.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jhonesgoncalves/super-http-ts/issues"
  },
  "homepage": "https://github.com/jhonesgoncalves/super-http-ts#readme",
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "29.4.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "8.35.0",
    "eslint-plugin-jest": "27.2.1",
    "express": "^4.18.2",
    "jest": "29.4.3",
    "prettier": "2.8.4",
    "ts-jest": "^29.1.4",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.3.3"
  },
  "files": [
    "lib/**/*",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "axios": "^1.3.4"
  }
}
