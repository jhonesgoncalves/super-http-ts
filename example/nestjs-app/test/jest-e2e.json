{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "moduleNameMapper": {
    "^super-http/nestjs$": "<rootDir>/../node_modules/super-http/dist/nestjs/index.js",
    "^super-http$": "<rootDir>/../node_modules/super-http/dist/index.js"
  }
}
